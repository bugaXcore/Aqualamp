# Mock mode (default for local demo without Bluetooth hardware)
AQUALAMP_MOCK=1

# Device identifiers
# MAC + GATT UUIDs from full HCI snoop (B3.0-S300pro-03).
LIGHT_ADDRESS=C8:47:80:70:BB:07
SERVICE_UUID=0000fff0-0000-1000-8000-00805f9b34fb
CHARACTERISTIC_UUID=0000fff2-0000-1000-8000-00805f9b34fb

# Optional: AQUALAMP_ALLOW_HARDWARE=1 (legacy override; PROTOCOL_CAPTURES_READY is now true)

# Bridge
BRIDGE_PORT=8787
BRIDGE_HOST=127.0.0.1

# Auto-reconnect (bridge defaults on; CLI defaults off)
AQUALAMP_AUTO_RECONNECT=1
# Per-attempt GATT connect timeout (ms). Scan/discovery still use ~45s.
# AQUALAMP_CONNECT_TIMEOUT_MS=12000
