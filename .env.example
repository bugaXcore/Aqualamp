# Mock mode is the default. Set to 0 to drive the real lamp through the Python sidecar.
AQUALAMP_MOCK=1

# Lamp BLE address (Windows/Linux). Leave unset to scan for a "B3.0-" lamp.
LIGHT_ADDRESS=C8:47:80:70:BB:07

# Bridge
BRIDGE_PORT=8787
BRIDGE_HOST=127.0.0.1

# Automatic reconnect attempts after an unexpected drop (bridge). 0 turns it off.
AQUALAMP_RECONNECT_ATTEMPTS=3

# Send brightness-corrected levels so sliders look linear.
# AQUALAMP_CALIBRATED=0
