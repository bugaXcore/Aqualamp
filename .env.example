# Mock mode (default for local demo without Bluetooth hardware)
AQUALAMP_MOCK=1

# Device identifiers — replace before real BLE (BLOCKER)
LIGHT_ADDRESS=XX:XX:XX:XX:XX:XX
SERVICE_UUID=XXXX
CHARACTERISTIC_UUID=YYYY

# Bridge
BRIDGE_PORT=8787
BRIDGE_HOST=127.0.0.1

# Auto-reconnect (bridge defaults on; CLI defaults off)
AQUALAMP_AUTO_RECONNECT=1
